const usernameField: TestBotElement = isLocal ? selectors.usernameFieldLocal : selectors.usernameFieldBrowserStack

async function dumpPageSourceOnFailure(stepLabel: string): Promise<void> {
    console.error(`Failure at ${stepLabel} — dumping page source`)
    try {
        const pageSource = await driver.getPageSource()
        console.log(`─────────── PAGE SOURCE: ${stepLabel} ───────────`)
        console.log(pageSource)
    } catch (srcErr) {
        console.warn('getPageSource failed (session may be dead):', srcErr)
    }
}

async function submitUsername(): Promise<void> {
    const nextButtonCandidates = [
        '//android.widget.Button[contains(@text,"Next")]',
        '//android.widget.Button[contains(@text,"Continue")]',
        '//android.widget.Button[@resource-id="com.personcentredsoftware.care.delivery:id/ContinueButton"]',
        '//android.widget.Button[@resource-id="com.personcentredsoftware.care.delivery:id/NextButton"]',
        '//*[contains(@text,"Next")]',
    ]

    for (const xpath of nextButtonCandidates) {
        const candidate = await $(xpath)
        if (await candidate.isExisting().catch(() => false)) {
            await candidate.click()
            return
        }
    }

    for (const action of ['next', 'go', 'done']) {
        try {
            await driver.execute('mobile: performEditorAction', { action })
            await driver.pause(2000)
            return
        } catch (err) {
            console.warn(`performEditorAction "${action}" failed:`, err)
        }
    }

    throw new Error('Could not submit username with any supported method')
}

async function selectFromSearchPopup(
    dropdownTrigger: TestBotElement,
    optionLocator: TestBotElement,
    optionText: string
): Promise<void> {
    await testBot.click(dropdownTrigger)
    await driver.pause(1500)

    let optionVisible = await testBot.isVisible(optionLocator).catch(() => false)
    if (!optionVisible) {
        const searchVisible = await testBot.isVisible(selectors.pickerPopupSearchEntry).catch(() => false)
        if (searchVisible) {
            await testBot.click(selectors.pickerPopupSearchEntry)
            await testBot.enterText(selectors.pickerPopupSearchEntry, optionText, false)
            await driver.pause(1000)
            optionVisible = await testBot.isVisible(optionLocator).catch(() => false)
        }
    }

    if (!optionVisible) {
        await dumpPageSourceOnFailure(`selectFromSearchPopup - "${optionText}" not found`)
        throw new Error(`Could not find "${optionText}" in the search popup`)
    }

    await testBot.click(optionLocator)
    await driver.pause(1000)
}

// ─────────────────────────────────────────────
// Suite — Unsuccessful Enrolment: Invalid Username (TC 53212)
// ─────────────────────────────────────────────
describe('Care Delivery - Unsuccessful Enrolment - Invalid Username', () => {

    it('Step 1 - Select United Kingdom and Continue to Username screen', async () => {
        await selectFromSearchPopup(selectors.selectRegionDropdown, selectors.optionUnitedKingdom, 'United Kingdom')
        await testBot.waitUntilVisible(selectors.triggerEnrolLoginButton, 10000)
        await testBot.click(selectors.triggerEnrolLoginButton)
        await testBot.waitUntilVisible(usernameField, 20000)
    })

    it('Step 2 - Enter a username that does not exist and land directly on Password screen (no Terms/Continue validation)', async () => {
        await testBot.click(usernameField)
        await testBot.enterText(usernameField, INVALID_USERNAME, false)
        await driver.pause(1500)
        try {
            await driver.hideKeyboard()
        } catch (err) {
            console.warn('hideKeyboard before username submit failed:', err)
        }
        await submitUsername()
        await driver.pause(isLocal ? 3000 : 4000)

        // CONFIRMED: unlike a valid/existing username, an invalid one
        // skips the Terms screen entirely — no Continue button appears
        // in between, the app goes straight to the Password field.
        await testBot.waitUntilVisible(selectors.passwordField, 20000)
    })

    it('Step 3 - Enter any password, click Login and verify "Invalid username or password" message is shown', async () => {
        await testBot.click(selectors.passwordField)
        await testBot.enterText(selectors.passwordField, ANY_PASSWORD, false)
        await driver.pause(1500)
        try {
            await driver.hideKeyboard()
        } catch (err) {
            console.warn('hideKeyboard failed or keyboard already hidden:', err)
        }

        await testBot.waitUntilVisible(selectors.identityLoginButton, 10000)
        await testBot.click(selectors.identityLoginButton)
        await driver.pause(3000)

        try {
            await testBot.waitUntilVisible(selectors.invalidCredentialsMessage, 15000)
        } catch (err) {
            await dumpPageSourceOnFailure('Step 3 (Invalid username or password message)')
            throw err
        }

        const isVisible = await testBot.isVisible(selectors.invalidCredentialsMessage)
        expect(isVisible).toBe(true)

        const stillOnPasswordScreen = await testBot.isVisible(selectors.passwordField).catch(() => false)
        expect(stillOnPasswordScreen).toBe(true)
    })
})
