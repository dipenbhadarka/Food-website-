// ═══════════════════════════════════════════════
// SELECT DURATION
//
// FIXED: this is the timing-related issue — the
// retry loop previously used a fixed 5s
// waitForEnabled per attempt (3 attempts, 15s
// total budget) with no page-source dump on final
// failure, so a slower app response (BrowserStack
// especially) could exhaust all attempts with zero
// diagnostic information about why Continue never
// enabled. Widened per-attempt wait to 8s,
// increased retry count to 4 (32s total budget),
// added a re-existence check before each click
// attempt, and added a page-source dump if
// Continue still never enables after all retries.
// The random-selection-from-whatever-is-rendered
// logic itself (10 mins / 15 mins / any other
// preset) is unchanged — it was already correct.
// ═══════════════════════════════════════════════

async function selectDurationOption(): Promise<boolean> {
    // Scoping to the DurationField container's TextViews only
    // found "Other Durations" on this screen — the numbered
    // presets (1/2/5/10/15/20/30/45/60 mins) apparently aren't
    // reliably reachable through that resource-id here, so
    // search all TextViews on screen and filter by text
    // instead of relying on the container id.
    const durationOptionXpath =
        '//android.widget.TextView[' +
        'contains(@text, "mins") or ' +
        '@text="Other Durations"' +
        ']'

    let presetElements = await $$(durationOptionXpath)
    let presetCount = await presetElements.length

    for (let attempt = 0; attempt < 3 && presetCount === 0; attempt++) {
        console.log(`▶ Scrolling for duration options — attempt ${attempt + 1}`)
        const { width, height } = await driver.getWindowSize()
        await driver.execute('mobile: swipeGesture', {
            left: Math.floor(width * 0.2),
            top: Math.floor(height * 0.6),
            width: Math.floor(width * 0.6),
            height: Math.floor(height * 0.3),
            direction: 'up',
            percent: 0.5,
        })
        await driver.pause(500)
        presetElements = await $$(durationOptionXpath)
        presetCount = await presetElements.length
    }

    if (presetCount === 0) {
        console.warn('No preset duration options found — trying Other Durations')
        return await selectOtherDurationWithRandomValue()
    }

    // Read every option's text up front, since "Other Durations"
    // is one of the matched candidates — the random pick below
    // can legitimately land on it, and it needs a completely
    // different handling path (open the manual entry field,
    // type a random value) rather than a plain tap like a
    // numbered preset.
    const optionTexts: string[] = []
    for (const el of presetElements) {
        optionTexts.push(await el.getText().catch(() => ''))
    }

    const randomIndex = Math.floor(Math.random() * presetCount)
    const randomDuration = optionTexts[randomIndex]

    console.log(`▶ Randomly chosen duration option: "${randomDuration || '(unknown text)'}" (from ${presetCount} available: ${optionTexts.join(', ')})`)

    if (randomDuration.toLowerCase().includes('other')) {
        console.log('▶ Random pick landed on "Other Durations" — routing to manual entry with a random 1-150 minute value')
        return await selectOtherDurationWithRandomValue()
    }

    const durationXpath = `//android.widget.TextView[@text="${randomDuration}"]`
    let durationElement = await $(durationXpath)

    const confirmButtonXpath = '//android.widget.Button[@resource-id="com.personcentredsoftware.care.delivery:id/ConfirmButton"]'
    let confirmEnabled = false

    // NB: previously waited a fixed 1500ms after every click
    // before even checking Continue, then gave waitForEnabled
    // a full 8s regardless — on a normal tap this resolves in
    // well under a second, so most of that time was pure
    // overhead. Trimmed the post-click pause and shortened the
    // enable-check timeout; the retry loop still escalates
    // (tries again) if a given attempt genuinely needs longer,
    // so nothing that previously passed should now fail — it
    // should just stop waiting once it's already succeeded.
    for (let attempt = 0; attempt < 3 && !confirmEnabled; attempt++) {
        durationElement = await $(durationXpath)

        const stillExists = await durationElement.isExisting().catch(() => false)
        if (!stillExists) {
            console.warn(`Duration option "${randomDuration}" no longer exists on screen (attempt ${attempt + 1}) — re-querying`)
            continue
        }

        await durationElement.click()
        console.log(`✓ Selected duration: ${randomDuration} (attempt ${attempt + 1})`)

        const confirmButton = await $(confirmButtonXpath)
        confirmEnabled = await confirmButton.waitForEnabled({ timeout: 3000 }).catch(() => false)
        console.log(`▶ Continue enabled: ${confirmEnabled}`)
    }

    if (!confirmEnabled) {
        await dumpPageSourceOnFailure(`selectDurationOption - Continue never enabled after 4 attempts selecting "${randomDuration}"`)
    }

    return confirmEnabled
}

// ═══════════════════════════════════════════════
// Opens "Other Durations" and enters a genuinely
// RANDOM value between 1 and 120 minutes — never
// a fixed value — then verifies Continue becomes
// enabled, with a page-source dump if it doesn't.
// ═══════════════════════════════════════════════

async function selectOtherDurationWithRandomValue(): Promise<boolean> {
    const randomMinutes = String(Math.floor(Math.random() * 120) + 1) // 1-120 inclusive

    console.log(`▶ Entering random "Other Durations" value: ${randomMinutes} minutes`)

    const visible = await testBot.isVisible(selectors.otherDurationsOption).catch(() => false)
    if (!visible) {
        await dumpPageSourceOnFailure('selectOtherDurationWithRandomValue - "Other Durations" button not found')
        return false
    }

    await testBot.click(selectors.otherDurationsOption)
    await driver.pause(500)

    try {
        await testBot.waitUntilVisible(selectors.durationEntryField, 5000)
    } catch (err) {
        await dumpPageSourceOnFailure('selectOtherDurationWithRandomValue - duration entry field did not appear')
        return false
    }

    await testBot.click(selectors.durationEntryField)
    await testBot.enterText(selectors.durationEntryField, randomMinutes, false)

    try {
        await driver.hideKeyboard()
    } catch (err) {
        // Ignore — keyboard may already be closed.
    }
    await driver.pause(300)

    const confirmButtonXpath = '//android.widget.Button[@resource-id="com.personcentredsoftware.care.delivery:id/ConfirmButton"]'
    const confirmButton = await $(confirmButtonXpath)
    const confirmEnabled = await confirmButton.waitForEnabled({ timeout: 4000 }).catch(() => false)

    console.log(`▶ Continue enabled after entering ${randomMinutes} minutes: ${confirmEnabled}`)

    if (!confirmEnabled) {
        await dumpPageSourceOnFailure(`selectOtherDurationWithRandomValue - Continue never enabled after entering ${randomMinutes} minutes`)
    }

    return confirmEnabled
}


