async function completeCloseNavigation(): Promise<void> {
    console.log('════════ FINAL CLOSE FLOW ════════')

    console.log('▶ Looking for bottom Close button')
    await testBot.waitUntilVisible(selectors.careNoteBottomCloseButton, 10000)
    await testBot.click(selectors.careNoteBottomCloseButton)
    console.log('✓ Clicked bottom Close button')
    await driver.pause(2000)

    // NB: reported issue — bottom Close sometimes goes straight
    // to My Communities, skipping the Earlier page entirely.
    // Check for this explicitly BEFORE waiting for Earlier, so
    // if it happens we log it clearly and skip the now-irrelevant
    // Earlier/right-close steps, rather than either hanging on a
    // waitUntilVisible that will never resolve, or a stale
    // earlierTab locator falsely matching something on the
    // Communities screen and silently "passing" through a screen
    // we were never actually on.
    const alreadyOnCommunities = await testBot.isVisible(selectors.myCommunitiesTab).catch(() => false)

    if (alreadyOnCommunities) {
        console.log('▶ Bottom Close landed directly on My Communities — Earlier page was skipped for this care note type')
        console.log('✓ My Communities displayed')
        console.log('════════ CLOSE FLOW COMPLETE (Earlier step skipped) ════════')
        return
    }

    console.log('▶ Looking for Earlier')
    try {
        await testBot.waitUntilVisible(selectors.earlierTab, 10000)
    } catch (err) {
        await dumpPageSourceOnFailure('completeCloseNavigation - Earlier tab not found and not on My Communities either')
        throw err
    }
    await testBot.click(selectors.earlierTab)
    console.log('✓ Clicked Earlier')
    await driver.pause(2000)

    console.log('▶ Looking for right-side Close icon')
    await testBot.waitUntilVisible(selectors.earlierRightCloseIcon, 10000)
    await testBot.click(selectors.earlierRightCloseIcon)
    console.log('✓ Clicked right-side Close icon')
    await driver.pause(2000)

    await testBot.waitUntilVisible(selectors.myCommunitiesTab, 30000)
    const myCommunitiesVisible = await testBot.isVisible(selectors.myCommunitiesTab).catch(() => false)

    if (!myCommunitiesVisible) {
        throw new Error('My Communities was not displayed after right-side Close')
    }
    console.log('✓ My Communities displayed')
    console.log('════════ CLOSE FLOW COMPLETE ════════')
}

let weightScenarioFailed = false

async function runWeightScenario(
    step: string,
    action: () => Promise<void>
): Promise<void> {
    try {
        await action()
    } catch (error) {
        weightScenarioFailed = true
        await dumpPageSourceOnFailure(step)
        throw error
    }
}

describe('Resident Area Profile - Observations - Weight', () => {
    beforeEach(function () {
        if (weightScenarioFailed) {
            this.skip()
        }
    })

    it('Validates the accepted 20-500 range using boundary value analysis', async () => {
        await runWeightScenario('Weight boundary value analysis', async () => {
            await navigateToWeightEntryScreen()
            await runBoundaryValueAnalysis()
            await createCareNote()
            await completeCloseNavigation()
        })
    })

    it('Leaves Weight blank for a random resident and completes the care note', async () => {
        await runWeightScenario('blank Weight', async () => {
            await navigateToWeightEntryScreen()
            await clearWeight()

            if (await isValidationVisible()) {
                throw new Error('Blank Weight unexpectedly displayed validation')
            }

            await submitCareNote()
            await completeCloseNavigation()
        })
    })

    it('Rejects zero and negative Weight values, then completes with a valid value', async () => {
        await runWeightScenario('zero and negative Weight', async () => {
            await navigateToWeightEntryScreen()

            for (const value of ['0', '-1']) {
                await enterWeightValue(value)
                if (!(await isValidationVisible())) {
                    throw new Error(`Weight value ${value} should display validation`)
                }
            }

            await createCareNote()
            await completeCloseNavigation()
        })
    })
})
