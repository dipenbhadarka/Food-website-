async function dumpPageSourceOnFailure(step: string): Promise<void> {
    console.error(`Failure at ${step}`)
    try {
        console.log(await driver.getPageSource())
    } catch (error) {
        console.error('Could not get page source', error)
    }
}

async function isVisible(element: TestBotElement): Promise<boolean> {
    return testBot.isVisible(element).catch(() => false)
}

async function selectResident(name: string): Promise<void> {
    if (await isVisible(residentLocator(name))) {
        await testBot.click(residentLocator(name))
        return
    }

    if ((process.env.PLATFORM || 'android').toLowerCase() === 'android') {
        const resident = await $(
            'android=new UiScrollable(new UiSelector().scrollable(true).instance(0))' +
            `.scrollIntoView(new UiSelector().text("${name}"))`
        )
        await resident.waitForDisplayed({ timeout: 20000 })
        await resident.click()
        return
    }

    throw new Error(`Resident "${name}" is not visible`)
}

// ── CHANGED from single-field observations: function name +
// "Blood pressure" text target, same navigation structure ──
async function openBloodPressureCareNote(residentName: string): Promise<void> {
    await testBot.waitUntilVisible(selectors.myCommunitiesTab, 120000)

    await selectResident(residentName)
    console.log(`Selected resident: ${residentName}`)

    await testBot.waitUntilVisible(selectors.adhocButton, 10000)
    await testBot.click(selectors.adhocButton)

    let bloodPressureVisible = await isVisible(selectors.bloodPressureText)

    if (!bloodPressureVisible && await isVisible(selectors.expandAllSectionsButton)) {
        await testBot.click(selectors.expandAllSectionsButton)
        await driver.pause(500)
        bloodPressureVisible = await isVisible(selectors.bloodPressureText)
    }

    if (!bloodPressureVisible) {
        const bloodPressure = await $(
            'android=new UiScrollable(new UiSelector().scrollable(true).instance(0))' +
            '.scrollIntoView(new UiSelector().text("Blood pressure"))'
        )
        await bloodPressure.waitForDisplayed({ timeout: 10000 })
    }

    await selectBloodPressureTile()

    await testBot.waitUntilVisible(selectors.nextButton, 10000)
    await testBot.click(selectors.nextButton)

    // Both fields render together on the same screen — wait for
    // the systolic field, since it's field [1] and appears first.
    await testBot.waitUntilVisible(selectors.systolicInput, 10000)
    await testBot.waitUntilVisible(selectors.diastolicInput, 5000)
}

async function tapElementCenter(element: any): Promise<void> {
    const location = await element.getLocation()
    const size = await element.getSize()
    const x = Math.round(location.x + size.width / 2)
    const y = Math.round(location.y + size.height / 2)

    await driver.performActions([{
        type: 'pointer',
        id: 'blood-pressure-tap',
        parameters: { pointerType: 'touch' },
        actions: [
            { type: 'pointerMove', duration: 0, x, y },
            { type: 'pointerDown', button: 0 },
            { type: 'pause', duration: 100 },
            { type: 'pointerUp', button: 0 },
        ],
    }])
}

async function selectBloodPressureTile(): Promise<void> {
    const bloodPressureTileXpath = await (testBot as any)
        .getLocatorTextForElement(selectors.bloodPressureSelectionButton)
    const bloodPressureTile = await $(bloodPressureTileXpath)
    await bloodPressureTile.waitForDisplayed({ timeout: 10000 })

    await tapElementCenter(bloodPressureTile)
    await driver.pause(1000)

    if (!(await isVisible(selectors.nextButton))) {
        const suppliedXpath = await (testBot as any)
            .getLocatorTextForElement(selectors.suppliedBloodPressureImage)
        const suppliedImage = await $(suppliedXpath)

        if (await suppliedImage.isDisplayed().catch(() => false)) {
            await tapElementCenter(suppliedImage)
            await driver.pause(1000)
        }
    }

    if (!(await isVisible(selectors.nextButton))) {
        throw new Error('Blood pressure tile was tapped but Next did not appear')
    }
}

// ── Field-specific setters/clearers — each takes an
// explicit selector so systolic and diastolic can be set
// independently, in either order, without duplicating logic.
async function setFieldValue(field: TestBotElement, value: string): Promise<void> {
    const xpath = await (testBot as any).getLocatorTextForElement(field)
    const input = await $(xpath)
    await input.waitForDisplayed({ timeout: 10000 })
    await input.click()
    await input.clearValue()
    await driver.pause(300)
    await input.setValue(value)

    try {
        await driver.hideKeyboard()
    } catch {
        // The keyboard may already be closed on cloud devices.
    }
    await driver.pause(700)
}

async function clearFieldValue(field: TestBotElement, fieldLabel: string): Promise<void> {
    const xpath = await (testBot as any).getLocatorTextForElement(field)
    const input = await $(xpath)
    await input.waitForDisplayed({ timeout: 10000 })
    await input.click()
    await input.clearValue()

    try {
        await driver.hideKeyboard()
    } catch {
        // The keyboard may already be closed on cloud devices.
    }
    await driver.pause(700)

    const value = (process.env.PLATFORM || 'android').toLowerCase() === 'android'
        ? await input.getAttribute('text')
        : await input.getValue()

    if (value !== '') {
        throw new Error(`${fieldLabel} field was not blank. Current value: "${value}"`)
    }
}

async function setSystolic(value: string): Promise<void> {
    await setFieldValue(selectors.systolicInput, value)
}

async function setDiastolic(value: string): Promise<void> {
    await setFieldValue(selectors.diastolicInput, value)
}

async function setBloodPressure(systolic: string, diastolic: string): Promise<void> {
    await setSystolic(systolic)
    await setDiastolic(diastolic)
}

async function clearSystolic(): Promise<void> {
    await clearFieldValue(selectors.systolicInput, 'Systolic')
}

async function clearDiastolic(): Promise<void> {
    await clearFieldValue(selectors.diastolicInput, 'Diastolic')
}

async function expectClinicalValidation(
    fieldSpecificLocator: TestBotElement,
    expected: boolean
): Promise<void> {
    const displayed = await isVisible(fieldSpecificLocator)

    if (displayed !== expected) {
        throw new Error(
            `Expected clinical validation to be ${expected ? 'displayed' : 'hidden'}`
        )
    }
}

async function expectSystolicValidation(expected: boolean): Promise<void> {
    await expectClinicalValidation(selectors.systolicValidationError, expected)
}

async function expectDiastolicValidation(expected: boolean): Promise<void> {
    await expectClinicalValidation(selectors.diastolicValidationError, expected)
}

async function expectGuidance(
    lowLocator: TestBotElement,
    highLocator: TestBotElement,
    expected: 'present' | 'none'
): Promise<void> {
    let lowVisible = false
    let highVisible = false

    for (let attempt = 0; attempt < 5; attempt++) {
        lowVisible = await isVisible(lowLocator)
        highVisible = await isVisible(highLocator)

        if (lowVisible || highVisible || expected === 'none') {
            break
        }

        await driver.pause(500)
    }

    const guidanceVisible = lowVisible || highVisible

    if (expected === 'present' && !guidanceVisible) {
        console.warn(
            'Expected personalized Blood Pressure guidance, but no guidance text was visible. ' +
            'Continuing because BrowserStack baseline data may not show guidance for this resident.'
        )
        return
    }
    if (expected === 'none' && guidanceVisible) {
        throw new Error('Personalized guidance was shown inside the baseline range')
    }
}

async function expectSystolicGuidance(expected: 'present' | 'none'): Promise<void> {
    await expectGuidance(selectors.lowSystolicGuidance, selectors.highSystolicGuidance, expected)
}

async function expectDiastolicGuidance(expected: 'present' | 'none'): Promise<void> {
    await expectGuidance(selectors.lowDiastolicGuidance, selectors.highDiastolicGuidance, expected)
}

// Boundary analysis keeps entry order consistent: systolic first,
// then diastolic. The other field is held at a known-valid value.
async function runSystolicBoundaryAnalysis(): Promise<void> {
    for (const testCase of SYSTOLIC_BOUNDARY_CASES) {
        console.log(
            `Testing ${testCase.valid ? 'valid' : 'invalid'} Systolic value: "${testCase.value}"`
        )
        await setSystolic(testCase.value)
        await setDiastolic(VALID_DIASTOLIC)
        await expectSystolicValidation(!testCase.valid)
        await expectDiastolicValidation(false)
    }
}

async function runDiastolicBoundaryAnalysis(): Promise<void> {
    for (const testCase of DIASTOLIC_BOUNDARY_CASES) {
        console.log(
            `Testing ${testCase.valid ? 'valid' : 'invalid'} Diastolic value: "${testCase.value}"`
        )
        await setSystolic(VALID_SYSTOLIC)
        await expectSystolicValidation(false)
        await setDiastolic(testCase.value)
        await expectDiastolicValidation(!testCase.valid)
    }
}

async function selectRequiredDuration(): Promise<void> {
    for (let attempt = 0; attempt < 5; attempt++) {
        const durationXpath = await (testBot as any)
            .getLocatorTextForElement(selectors.durationOptions)
        const durationOptions = await $$(durationXpath)
        const visibleOptions = []

        for (const option of durationOptions) {
            if (await option.isDisplayed().catch(() => false)) {
                visibleOptions.push(option)
            }
        }

        if (visibleOptions.length > 0) {
            const randomIndex = Math.floor(Math.random() * visibleOptions.length)
            const selectedOption = visibleOptions[randomIndex]
            const selectedDuration = await selectedOption.getText().catch(() => '')

            await selectedOption.click()
            console.log(`Selected duration: ${selectedDuration}`)
            return
        }

        const { width, height } = await driver.getWindowSize()
        await driver.execute('mobile: swipeGesture', {
            left: Math.floor(width * 0.2),
            top: Math.floor(height * 0.6),
            width: Math.floor(width * 0.6),
            height: Math.floor(height * 0.3),
            direction: 'up',
            percent: 0.5,
        })
        await driver.pause(750)
    }

    throw new Error('No duration option was found')
}

async function completeCareNote(): Promise<void> {
    await selectRequiredDuration()

    const confirmXpath = await (testBot as any)
        .getLocatorTextForElement(selectors.confirmButton)
    const confirmButton = await $(confirmXpath)
    await confirmButton.waitForDisplayed({ timeout: 10000 })
    await confirmButton.waitForEnabled({ timeout: 10000 })
    await confirmButton.click()

    await testBot.waitUntilVisible(selectors.createRecordsButton, 10000)
    await testBot.click(selectors.createRecordsButton)

    await testBot.waitUntilVisible(selectors.closeButton, 10000)
    await testBot.click(selectors.closeButton)

    await testBot.waitUntilVisible(selectors.earlierTab, 10000)
    await testBot.click(selectors.earlierTab)

    await testBot.waitUntilVisible(selectors.earlierCloseButton, 10000)
    await testBot.click(selectors.earlierCloseButton)

    await testBot.waitUntilVisible(selectors.myCommunitiesTab, 30000)
}

async function runStep(step: string, action: () => Promise<void>): Promise<void> {
    try {
        await action()
    } catch (error) {
        await dumpPageSourceOnFailure(step)
        throw error
    }
}

describe('Resident Area Profile - Observations - Blood Pressure', () => {

    it('Validates boundaries, re-enters valid baseline Blood Pressure values and completes the care note', async () => {
        await runStep('baseline Blood Pressure', async () => {
            await openBloodPressureCareNote(BASELINE_RESIDENT)

            await runSystolicBoundaryAnalysis()
            await runDiastolicBoundaryAnalysis()

            await setBloodPressure(String(SYSTOLIC_BASELINE_MIN - 1), VALID_DIASTOLIC)
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await expectSystolicGuidance('present')

            await setBloodPressure(String(SYSTOLIC_BASELINE_MAX + 1), VALID_DIASTOLIC)
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await expectSystolicGuidance('present')

            await setBloodPressure(VALID_SYSTOLIC, String(DIASTOLIC_BASELINE_MIN - 1))
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await expectDiastolicGuidance('present')

            await setBloodPressure(VALID_SYSTOLIC, String(DIASTOLIC_BASELINE_MAX + 1))
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await expectDiastolicGuidance('present')

            await setBloodPressure(VALID_SYSTOLIC, VALID_DIASTOLIC)
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await expectSystolicGuidance('none')
            await expectDiastolicGuidance('none')

            await completeCareNote()
        })
    })

    it('Leaves both Blood Pressure fields blank for a new non-baseline resident and completes the care note', async () => {
        await runStep('blank non-baseline Blood Pressure', async () => {
            await openBloodPressureCareNote(NON_BASELINE_RESIDENT)
            await clearSystolic()
            await clearDiastolic()
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await completeCareNote()
        })
    })

    it('Rejects zero, negative and out-of-range Blood Pressure values, then completes with valid values', async () => {
        await runStep('out-of-range Blood Pressure', async () => {
            await openBloodPressureCareNote(NON_BASELINE_RESIDENT)

            for (const value of ['0', '-1', String(SYSTOLIC_CLINICAL_MAX + 1)]) {
                await setSystolic(value)
                await setDiastolic(VALID_DIASTOLIC)
                await expectSystolicValidation(true)
                await expectDiastolicValidation(false)
            }

            for (const value of ['0', '-1', String(DIASTOLIC_CLINICAL_MAX + 1)]) {
                await setSystolic(VALID_SYSTOLIC)
                await expectSystolicValidation(false)
                await setDiastolic(value)
                await expectDiastolicValidation(true)
            }

            await setBloodPressure(VALID_SYSTOLIC, VALID_DIASTOLIC)
            await expectSystolicValidation(false)
            await expectDiastolicValidation(false)
            await completeCareNote()
        })
    })

})
