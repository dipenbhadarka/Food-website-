{
  "name": "smoketests",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "powershell -NoProfile -Command \"$env:RUN_MODE='local'; wdio run ./config/wdio.conf.ts --require ts-node/register\"",
    "test:browserstack": "powershell -NoProfile -Command \"$env:RUN_MODE='browserstack'; wdio run ./config/wdio.conf.ts --require ts-node/register\"",
    "test:enrolment:local": "powershell -NoProfile -Command \"$env:RUN_MODE='local'; wdio run ./config/wdio.conf.ts --spec ./test/specs/enrolment.e2e.ts --require ts-node/register\"",
    "test:enrolment:browserstack": "powershell -NoProfile -Command \"$env:RUN_MODE='browserstack'; wdio run ./config/wdio.conf.ts --spec ./test/specs/enrolment.e2e.ts --require ts-node/register\"",
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^9.0.0"
  },
  "resolutions": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/which": "^3.0.4",
    "@wdio/appium-service": "^9.29.1",
    "@wdio/browserstack-service": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/types": "^9.29.1",
    "appium-uiautomator2-driver": "^7.4.0",
    "eslint": "^9.37.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@appium/base-driver": "^10.5.0",
    "@appium/support": "^7.2.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/logger": "^9.29.1",
    "appium": "^3.5.0",
    "dotenv": "^17.2.3",
    "expect": "^30.2.0",
    "expect-webdriverio": "^5.4.3",
    "jquery": "^3.7.1",
    "webdriverio": "^9.29.1",
    "which": "^5.0.0"
  }
